# Deployment environment for one client wedding.
# Copy to deploy/.env, fill in, and keep it out of git. See docs/CLIENT_DEPLOYMENT.md.

# --- Identity ---------------------------------------------------------------
SITE_DOMAIN=sarahandadam.example.com
TLS_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
# Not published outside the compose network; the password still matters, because
# anything that gets onto that network can reach it.
POSTGRES_USER=wedding
POSTGRES_PASSWORD=
POSTGRES_DB=wedding

# --- Application ------------------------------------------------------------
# MUST be unique per client. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
LOG_LEVEL=info

# --- Email (Resend) ---------------------------------------------------------
# Leave blank and messages are written to the container log instead of sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
