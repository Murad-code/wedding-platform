# Deployment environment for one client wedding.
# Copy to deploy/.env, fill in, and keep it out of git. See docs/CLIENT_DEPLOYMENT.md.

# --- Identity ---------------------------------------------------------------
SITE_DOMAIN=sarahandadam.example.com
TLS_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
# Not published outside the compose network; the password still matters, because
# anything that gets onto that network can reach it.
POSTGRES_USER=wedding
POSTGRES_PASSWORD=
POSTGRES_DB=wedding

# --- Application ------------------------------------------------------------
# MUST be unique per client. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
LOG_LEVEL=info

# --- Media storage (S3, R2, or any S3-compatible store) ----------------------
# Leave S3_BUCKET blank to keep uploads on the local `media` volume. Set it, and every
# other S3_ variable becomes required: a half-configured bucket refuses to start.
# Give each wedding its own private bucket and a key scoped to that bucket only.
# Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) ---------------------------------------------------------
# Leave blank and messages are written to the container log instead of sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
