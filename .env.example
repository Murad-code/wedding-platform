# Copy to .env and fill in. NEVER commit .env — see docs/SECURITY.md §8.

# --- Database ---------------------------------------------------------------
# Local development uses the Postgres service in docker-compose.yml (pnpm db:up).
# Port 5433 is used deliberately so the dev database never collides with a Postgres
# you may already run on the default 5432.
DATABASE_URL=postgres://wedding:wedding@localhost:5433/wedding

# --- Payload ----------------------------------------------------------------
# MUST be unique per client deployment and at least 32 characters.
# Reusing a secret would let one wedding's session cookies validate against another's.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-generated-secret-at-least-32-chars

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage ----------------------------------------------------------
# Development writes to local disk. Production uses S3-compatible storage (e.g. R2)
# with a bucket per client.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email (Resend) ---------------------------------------------------------
# Leave unset and the platform logs messages to the server console instead of sending
# them. Both the key and the from address are required before email is really sent.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=

# --- SMS (Twilio) -----------------------------------------------------------
# All three are required before a text is really sent; otherwise messages are logged.
# SMS also needs the `smsNotifications` feature enabled in wedding settings, and each
# guest's recorded consent — see docs/SECURITY.md §7.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
